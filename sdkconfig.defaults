# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 的所有硬件批次均使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 烧录时按实际探测容量回写镜像头。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=y

# --- 分区表 ---
# WiFi+TLS+MQTT 后固件约 1.6MB,默认单 APP 表(1MB)不够,用自定义表给 factory 4M。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 关掉 malloc 断言:分配失败时 LVGL 源码自带优雅降级(跳过该字形继续画),
# 而断言会走 while(1) 死循环把 taskLVGL 锁死(IDLE 饿死 → 看门狗风暴)。
# 池 98% 满时偶发的字形缓冲分配失败,宁可缺个字不能整机卡死。
# CONFIG_LV_USE_ASSERT_MALLOC is not set
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(字节)。独立静态区,配太大会挤占系统 RAM 影响 TLS/MQTT。
# 48KB 时 UI 对象(~43KB)+渲染耗尽导致 SW 渲染卡死;72KB 时 TLS 握手堆不足连不上云。
# 64KB + AMS 页懒构建(见 app_printer.c ensure_ams_pages)后池仅用 46%,两者兼得。
# 注意:旧键 LV_MEM_SIZE_KILOBYTES 已被 LVGL 9 弃用,必须用 LV_MEM_SIZE(字节)。
CONFIG_LV_MEM_SIZE=65536

# --- TLS ---
# 配网页要在设备端直连 api.bambulab.cn 做短信登录。C3 无 PSRAM,
# 固定 16KB+4KB 的 TLS 收发缓冲会在握手时把堆吃光(RSA 校验 alloc 失败),
# 改为按需分配/释放后,配网 HTTPS 与监控 MQTT 大报文都能正常工作。
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
